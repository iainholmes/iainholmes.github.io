{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-entry.private.schema.json",
  "title": "Field Log memory \u2014 browser-local",
  "description": "Actual localStorage rupert-field-log-v1 record; version 1/2 JSON backups. Never a public asset. Identity resolution is non-destructive and legacy completion remains unclassified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "place",
    "activity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fl_[a-zA-Z0-9_-]{1,100}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "season": {
      "enum": [
        "spring",
        "summer",
        "autumn",
        "winter"
      ]
    },
    "source": {
      "enum": [
        "planned",
        "unplanned",
        "rupert-day"
      ]
    },
    "history_kind": {
      "enum": [
        "visit",
        "completed",
        "unclassified"
      ]
    },
    "association_manual": { "type": "boolean" },
    "photos": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^data:image/(jpeg|png|webp);base64,"
      }
    },
    "place": {
      "type": "string",
      "maxLength": 200
    },
    "activity": {
      "type": "string",
      "maxLength": 300
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "prompt": {
      "type": "string",
      "maxLength": 1000
    },
    "edition": {
      "type": "string",
      "maxLength": 100
    },
    "experience": {
      "type": "string",
      "maxLength": 100
    },
    "tags": {
      "type": "string",
      "maxLength": 500
    },
    "place_id": {
      "type": "string",
      "maxLength": 100
    },
    "experience_id": {
      "type": "string",
      "maxLength": 160
    }
  }
}
