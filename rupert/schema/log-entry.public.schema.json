{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-entry.public.schema.json",
  "title": "Field Log entry — public",
  "description": "The only Field Log shape that may be written to the repository. Built field by field from explicit approvals; never derived by stripping a private entry. Unknown properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "date", "place_id", "title"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^fl_[0-9A-HJKMNP-TV-Z]{26}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "place_id": { "type": "string" },
    "edition_ref": { "type": "object", "additionalProperties": false, "required": ["id", "role"],
      "properties": { "id": { "type": "string" }, "role": { "enum": ["flagship", "local_trail", "away_mission", "wildcard"] } } },
    "title": { "type": "string", "maxLength": 80 },
    "public_note": { "type": "string" },
    "rupert_highlight": { "type": "string" },
    "human_highlight": { "type": "string" },
    "return_interest": { "enum": ["soon", "seasonal", "someday", "once-was-enough", "not-for-rupert"] },
    "photos": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["file", "alt"],
      "properties": { "file": { "type": "string", "pattern": "^photos/[a-z0-9-]+$" }, "alt": { "type": "string" }, "caption": { "type": "string" },
        "focal": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } } } }
  }
}
