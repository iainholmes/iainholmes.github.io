{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "travel-plan.schema.json",
  "title": "Travel plan (browser only)",
  "description": "A trip as ordered legs. Never published. Only car and walk legs receive stop suggestions.",
  "type": "object",
  "required": ["id", "title", "legs"],
  "properties": {
    "id": { "type": "string", "pattern": "^tp_" },
    "title": { "type": "string" },
    "dates": { "type": "object", "properties": { "start": { "type": "string" }, "end": { "type": "string" } } },
    "legs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["seq", "mode", "from", "to"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "mode": { "enum": ["car", "air", "ferry", "rail", "walk"] },
          "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" },
          "depart": { "type": "string" }, "arrive": { "type": "string" },
          "detour_minutes": { "type": "integer", "minimum": 0, "description": "Car and walk legs only." },
          "stop_interest": { "type": "array", "items": { "enum": ["trail", "swim", "rest", "food", "overnight"] } }
        }
      }
    },
    "manual_stops": { "type": "array", "items": { "type": "object", "required": ["leg"], "properties": { "leg": { "type": "integer" }, "place_id": { "type": "string" }, "note": { "type": "string" } } } }
  },
  "$defs": {
    "point": {
      "type": "object",
      "properties": {
        "label": { "type": "string" }, "place_id": { "type": "string" }, "ref": { "type": "string" },
        "lat": { "type": "number" }, "lng": { "type": "number" },
        "precision": { "enum": ["exact", "town", "region"], "description": "Exact points never leave the browser except to a routing provider the user has enabled with disclosure." }
      }
    }
  }
}
